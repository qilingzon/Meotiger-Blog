---
import type { CollectionEntry } from 'astro:content';
import Tiger from './Tiger.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, accent } = post.data;
const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${post.id}/`} class="card post-card">
  <div class="post-card__head">
    <Tiger variant={accent} size={46} mode="face" />
    <div class="post-card__meta">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {
        tags.length > 0 && (
          <div class="post-card__tags">
            {tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
  <h3 class="post-card__title">{title}</h3>
  <p class="post-card__desc">{description}</p>
</a>

<style>
  .post-card {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .post-card__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .post-card__meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-card__meta time {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-display);
  }

  .post-card__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .post-card__title {
    margin: 0 0 4px;
    font-size: 19px;
  }

  .post-card__desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.7;
  }
</style>
