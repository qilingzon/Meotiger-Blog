---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tiger from '../components/Tiger.astro';
---

<BaseLayout title="迷路了" description="页面不存在——一群萌虎在池塘边迷路了。">
  <section class="container lost">
    <div class="lost__squad" aria-hidden="true">
      <Tiger variant="pink" size={56} />
      <Tiger variant="purple" size={56} />
      <Tiger variant="wild" size={56} />
      <Tiger variant="cyan" size={56} />
      <Tiger variant="gold" size={56} />
      <Tiger variant="blue" size={56} />
      <Tiger variant="green" size={56} />
    </div>
    <h1 class="lost__code">404</h1>
    <p>页面迷路了，池塘全员出来找——目前它们自己也迷路了。</p>
    <a class="btn" href="/">带回池塘</a>
  </section>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 24px 0;
  }

  .lost__squad {
    display: flex;
    gap: 14px;
    align-items: flex-end;
    animation: lost-float 4s ease-in-out infinite;
    flex-wrap: wrap;
    justify-content: center;
  }

  .lost__code {
    font-size: 56px;
    margin: 12px 0 0;
    color: var(--accent);
  }

  .lost p {
    color: var(--text-muted);
    margin-bottom: 26px;
  }

  @keyframes lost-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
</style>
